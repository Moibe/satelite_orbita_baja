# Transcripción en streaming (https://console.deepgram.com)
DEEPGRAM_API_KEY=

# Explicaciones con OpenAI: llave principal (CSI) y de respaldo (personal).
# Si la principal falla (llave inválida, sin cuota, límite de uso, caída), se usa la de respaldo
# y la ventanita muestra la etiqueta "respaldo". Deja la de respaldo vacía para desactivarlo.
OPENAI_API_KEY=
OPENAI_API_KEY_RESPALDO=

# Opcional: modelo que explica los conceptos (rápido y barato; default gpt-4o-mini)
EXPLAIN_MODEL=gpt-4o-mini
